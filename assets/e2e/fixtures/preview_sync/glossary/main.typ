// === НАЧАЛО === кода, предназначенного для задействования глоссария
//                      и дополнения его стандартных функций
#import "@preview/glossarium:0.5.10": * // Модуль GLOSSARIUM
#import "abbr-setup.typ": * // Файл, где импортируется глоссарий из CSV-файла
// Активируем глоссарий (glossarium) для всего документа
#show: make-glossary
// Подсветка первого развернутого упоминания сокращений для редактуры
// ВАЖНО: должна следовать строго после
// --- Переменная, указывающая, нужно ли вообще выделять первые появления аббревиатур
#let need-highlight-first-abbr-occur = true
// --- Зададим формат начертания первого появления аббревиатуры
#let highlight-first-abbr-occur(content) = highlight(fill: black)[#text(
  fill: red,
  weight: "bold",
)[#content]]
// --- Само правило выделения первых появлений аббревиатур
#show link: it => {
  // Проверяем, надо ли вообще подсвечивать первые появления аббревиатуры
  if need-highlight-first-abbr-occur {
    // Проверяем, что ссылка имеет отношение к нашей фигуре glossarium
    if it.has("dest") and type(it.dest) == label {
      context {
        // 1. Безопасно переводим ВСЮ последовательность элементов body в текстовую строку.
        // Метод repr() преобразует структуру в текст, где мы ищем маркеры первого упоминания.
        let body-dump = repr(it.body)

        // 2. glossarium на первом упоминании выводит длинную форму "Имя (СОКР)".
        // В дампе repr() для первого упоминания гарантированно будет подстрока с текстовыми скобками или "long".
        // Также мы проверяем длину дампа: у краткой формы (например, "ВПП") дамп короткий, а у длинной — огромный.
        if body-dump.contains("(") or body-dump.len() > 60 {
          // Выделяем первое упоминание в соответствии с ранее определённым правилом
          highlight-first-abbr-occur(it)
        } else {
          it // Последующие упоминания (краткие формы) не трогаем
        }
      }
    } else {
      it // Все остальные ссылки в документе (библиографию, рисунки) не трогаем
    }
  } else {
    it // Если НЕ надо, то НЕ выделяем первое упоминание аббревиатуры
  }
}
// Регистрируем глоссарий с жёстким приведением типов
// Метод .sorted() заставляет Typst МГНОВЕННО вычислить и зафиксировать в памяти
// весь массив до того, как пакет glossarium начнет искать ключи в тексте.
#register-glossary(my-glossary-entries.sorted(key: e => e.key))
// === ОКОНЧАНИЕ === кода, предназначенного для задействования глоссария

// Список сокращений и обозначений (аббревиатур)
#include "abbreviations.typ"

// ====================================================================
#csv("abbr-list.csv")

#lorem(400)

