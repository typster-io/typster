<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="ts-main">
    <div class="ts-page">
      <header class="ts-pagehead">
        <div>
          <h1 class="ts-h1">
            {gettext("projects.heading_lead")}
            <span class="ts-serif">{gettext("projects.heading_accent")}</span>
          </h1>
          <p class="ts-p ts-muted">{gettext("projects.index.subtitle")}</p>
        </div>
        <button
          id="new-project-button"
          phx-click="new_project"
          class="ts-btn ts-btn--primary"
        >
          <.icon name="hero-plus" class="size-3.5" /> {gettext("projects.new")}
        </button>
      </header>

      <div class="ts-toolbar">
        <div class="ts-search">
          <.icon name="hero-magnifying-glass" class="size-3.5" />
          <input
            id="project-search"
            phx-hook="SlashFocus"
            phx-keyup="search"
            phx-debounce="200"
            placeholder={gettext("projects.search.placeholder")}
            value={@search}
          />
          <span class="ts-kbd">/</span>
        </div>
        <div class="ts-seg" id="project-filter">
          <button
            :for={
              {key, label} <- [
                {"all", gettext("projects.filter.all")},
                {"recent", gettext("projects.filter.recent")},
                {"starred", gettext("projects.filter.starred")},
                {"archive", gettext("projects.filter.archive")}
              ]
            }
            type="button"
            id={"filter-#{key}"}
            phx-click="filter"
            phx-value-filter={key}
            class={[@filter == key && "is-active"]}
          >
            {label}
          </button>
        </div>
        <div class="ts-spacer" />
        <span class="ts-p ts-muted">
          {ngettext("projects.count.one", "projects.count.other", @project_count)}
        </span>
      </div>

      <ul id="projects" phx-update="stream" class="ts-list">
        <li class="ts-empty only:block hidden" id="projects-empty">
          {gettext("projects.empty")}
        </li>
        <li
          :for={{id, project} <- @streams.projects}
          id={id}
          class="ts-list__row"
        >
          <div class="ts-project-icon" style={"--ts-icon: #{project_hue(project.name)}"}>
            {project_initial(project.name)}
          </div>
          <div class="ts-list__main">
            <div class="ts-list__title">
              {project.name}
              <span :if={!owned?(@current_scope, project)} class="ts-shared-badge">
                <.icon name="hero-user-group" class="size-4" /> {gettext("projects.row.shared")}
              </span>
            </div>
            <div class="ts-list__sub">
              {gettext("projects.row.edited")} {relative_time(project.updated_at)} · {ngettext(
                "1 file",
                "%{count} files",
                file_count(@file_counts, project.id)
              )}
            </div>
          </div>
          <div class="ts-list__actions">
            <button
              type="button"
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              disabled
              title={gettext("projects.star_soon")}
              aria-label={gettext("projects.star_soon")}
            >
              <.icon name="hero-star" class="size-3.5" />
            </button>
            <button
              :if={owned?(@current_scope, project)}
              id={"delete-project-#{project.id}"}
              phx-click="delete"
              phx-value-id={project.id}
              phx-confirm={gettext("projects.delete.confirm")}
              class="ts-btn ts-btn--ghost ts-btn--icon ts-btn--sm"
              aria-label={gettext("projects.delete.label")}
            >
              <.icon name="hero-trash" class="size-3.5" />
            </button>
          </div>
          <.link
            navigate={~p"/projects/#{project.id}/edit"}
            class="ts-btn ts-btn--ghost ts-btn--sm"
          >
            {gettext("common.open")} <.icon name="hero-arrow-right" class="size-3" />
          </.link>
        </li>
      </ul>

      <div class="ts-cards">
        <button type="button" phx-click="new_project" class="ts-card ts-card--action">
          <div class="ts-card__action-icon">
            <.icon name="hero-document-text" class="size-4" />
          </div>
          <div class="ts-card__action-body">
            <div class="ts-card__action-title">{gettext("projects.template.title")}</div>
            <div class="ts-card__action-sub">{gettext("projects.template.sub")}</div>
          </div>
          <.icon name="hero-arrow-right" class="size-3.5 ts-muted" />
        </button>
        <div class="ts-card ts-card--action is-disabled" title={gettext("projects.import.soon")}>
          <div class="ts-card__action-icon ts-card__action-icon--success">
            <.icon name="hero-arrow-up-tray" class="size-4" />
          </div>
          <div class="ts-card__action-body">
            <div class="ts-card__action-title">{gettext("projects.import.title")}</div>
            <div class="ts-card__action-sub">{gettext("projects.import.sub")}</div>
          </div>
          <.icon name="hero-arrow-right" class="size-3.5 ts-muted" />
        </div>
      </div>

      <%!-- Template library: text sources a new project can start from. The
            new-project dialog lists them; the editor no longer carries them. --%>
      <section class="ts-tpl-panel" id="templates-panel">
        <div class="ts-tpl-panel__head">
          <h2 class="ts-h3">{gettext("projects.templates.title")}</h2>
          <span :if={@templates != []} class="ts-side__count">{length(@templates)}</span>
        </div>
        <p class="ts-tpl-panel__sub">{gettext("projects.templates.sub")}</p>
        <div class="ts-tpl">
          <div :for={tpl <- @templates} class="ts-tpl__row" id={"template-#{tpl.id}"}>
            <% kind = TypsterWeb.FileTree.file_chip_kind(tpl.name) %>
            <span class={["ts-filechip", "ts-filechip--#{kind}"]}>
              {TypsterWeb.FileTree.chip_glyph(kind)}
            </span>
            <span class="ts-tpl__name truncate">{tpl.name}</span>
            <button
              type="button"
              class="ts-tree__act ts-tree__act--danger"
              phx-click="delete_template"
              phx-value-id={tpl.id}
              phx-confirm={gettext("projects.templates.delete_confirm")}
              aria-label={gettext("projects.templates.delete")}
              title={gettext("projects.templates.delete")}
            >
              <.icon name="hero-trash" class="size-3" />
            </button>
          </div>

          <.form id="template-upload-form" for={%{}} phx-change="validate_template">
            <.live_file_input upload={@uploads.template} class="hidden" />
            <label
              for={@uploads.template.ref}
              class="ts-tpl__drop"
              phx-drop-target={@uploads.template.ref}
            >
              <.icon name="hero-arrow-up-tray" class="size-3.5" />
              <span>{gettext("projects.templates.upload")}</span>
            </label>
          </.form>
        </div>
      </section>
    </div>
  </main>

  <%= if @show_new_dialog do %>
    <div class="ts-overlay" phx-click="close_dialog">
      <div class="ts-dialog" phx-click="" phx-window-keydown="close_dialog" phx-key="Escape">
        <div class="ts-dialog__header">
          <h2 class="ts-dialog__title">{gettext("projects.new")}</h2>
          <p class="ts-dialog__desc">{gettext("projects.dialog.description")}</p>
        </div>
        <div class="ts-dialog__body">
          <.form for={%{}} id="new-project-form" phx-submit="create_project">
            <label class="ts-field">
              <span class="ts-field__label">{gettext("projects.name.label")}</span>
              <input
                class="ts-input"
                name="name"
                autofocus
                placeholder={gettext("projects.name.placeholder")}
                required
              />
            </label>
            <label :if={@templates != []} class="ts-field">
              <span class="ts-field__label">{gettext("projects.templates.start_from")}</span>
              <select class="ts-input" name="template" id="new-project-template">
                <option value="">{gettext("projects.templates.blank")}</option>
                <option :for={tpl <- @templates} value={tpl.id}>{tpl.name}</option>
              </select>
            </label>
            <div class="ts-dialog__footer">
              <button type="button" phx-click="close_dialog" class="ts-btn ts-btn--ghost">
                {gettext("common.cancel")}
              </button>
              <button type="submit" class="ts-btn ts-btn--primary">
                {gettext("projects.create")}
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
